# Game files and anything derived from them are never committed. They are
# produced on the user's own machine from the user's own copy of the game.
editor/data/
backups/
missions/_decompiled/
missions/_empty/
corpus/
cache/

# Pages the test and screenshot tools build next to the editor (the site's
# tools/shots.mjs writes editor/_shots.html while it runs)
editor/_*.html

# Generated on every Apply or dry run
missions/plan/
missions/plan-*/

# The user's own work: missions, their build inputs, history, recordings and
# conversations with the AI designer
missions/custom/

# Machine-specific settings written by tools/serve.py
config.json

# Secrets: API keys for the AI designer
.env

# Python
__pycache__/
*.pyc

# Node and the desktop shell
node_modules/
dist/
out/
*.tsbuildinfo

# The desktop app: the bundled server and the installers are built, not kept
app/dist-server/
app/build-server/

# Plans for larger changes and the roadmap: kept on this machine, not published
.dev/
